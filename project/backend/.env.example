PORT=3001

DATABASE_URL=file:./data/local.db
DATABASE_AUTH_TOKEN=

# Local dev      DATABASE_URL=file:./data/local.db
# VPS SQLite     DATABASE_URL=file:/data/app.db
# Turso          DATABASE_URL=libsql://xxx.turso.io
# Turso token    DATABASE_AUTH_TOKEN=...

# Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Mastercard sandbox (optional — mock processor + static FX are used when unset).
# Create a project on https://developer.mastercard.com with the Donations, BIN Lookup
# and Currency Conversion Calculator APIs; copy the sandbox consumer key and download
# the signing .p12 + client encryption certificate into backend/mastercard/ (gitignored).
# NOTE: escape any "$" in passwords as "\$" — Bun's .env parser expands $VAR even in quotes.
MASTERCARD_CONSUMER_KEY=
MASTERCARD_KEYSTORE_PATH=./mastercard/signing-key.p12
MASTERCARD_KEYSTORE_ALIAS=keyalias
MASTERCARD_KEYSTORE_PASSWORD=keystorepassword
MASTERCARD_CLIENT_ENC_CERT_PATH=./mastercard/client-encryption-cert.pem
MASTERCARD_BASE_URL=https://sandbox.api.mastercard.com/donations
MASTERCARD_BIN_BASE_URL=https://sandbox.api.mastercard.com/bin-resources
MASTERCARD_CURRENCY_BASE_URL=https://sandbox.api.mastercard.com/settlement/currencyrate
# Donate specifics: client id (X-Openapi-Clientid, from the project's Donate credentials)
# and the sandbox charity UUID onboarded for your project.
MASTERCARD_CLIENT_ID=
MASTERCARD_CHARITY_ID=

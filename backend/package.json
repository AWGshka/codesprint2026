{
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "mastercard:check": "bun run scripts/mastercard-check.ts",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run src/db/seed.ts",
    "db:reset": "bun run scripts/reset-db.ts",
    "user:create": "bun run scripts/create-user.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.15",
    "@libsql/client": "^0.17.4",
    "better-auth": "^1.6.22",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "mastercard-client-encryption": "^1.10.8",
    "mastercard-oauth1-signer": "^1.2.0",
    "node-forge": "^1.4.0"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@biomejs/biome": "2.5.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "^1.3.14",
    "@types/node-forge": "^1.3.14",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "prettier": "3.9.1",
    "typescript": "^6.0.3"
  }
}
